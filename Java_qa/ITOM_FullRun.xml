<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite verbose="2" name="ITOM_FullRun" configfailurepolicy="continue" thread-count="1">

    <listeners>
        <listener class-name="util.Listener"/>
        <listener class-name="util.PrometheusTestListener"/>
    </listeners>

    <!-- Runs first, no parallel to guarantee completion -->
    <test name="Prerequisites">
        <classes>
            <class name="ITOM.ITOM_Prerequisites"/>
        </classes>
    </test>

